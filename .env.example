# Copy to .env.local (or .env) and fill in. Never commit real secrets.

# PostgreSQL (docker-compose.yml starts a matching local database)
DATABASE_URL="postgresql://ecommerce_user:ecommerce_password@localhost:5432/ecommerce_db"
# Direct/session connection used by Prisma migrations (same as DATABASE_URL locally;
# with Supabase use the session pooler on port 5432)
DIRECT_URL="postgresql://ecommerce_user:ecommerce_password@localhost:5432/ecommerce_db"

# NextAuth: generate a secret with `openssl rand -base64 32`
NEXTAUTH_SECRET="change-me"
NEXTAUTH_URL="http://localhost:3000"

# Public app settings
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Demo Shop"

# Admin users created by db:seed / db:seed:admins (comma-separated emails)
ADMIN_EMAILS="admin@example.com"
ADMIN_PASSWORD="change-me"

# Optional real inbox base email for hero personas during db:seed
# Example: DEMO_INBOX_EMAIL="founder@gmail.com" -> seeds founder+sarah@gmail.com, founder+marcus@gmail.com, etc.
DEMO_INBOX_EMAIL=""

# --- AskDepth SDK & Component Maps (created manually during workspace onboarding) ---
# Browser Write Key (ad_bw_...) from AskDepth -> Settings -> Analytics Projects
NEXT_PUBLIC_ASKDEPTH_WRITE_KEY=""
# AskDepth Analytics Ingest endpoint (Cloud or local analytics-ingest)
NEXT_PUBLIC_ASKDEPTH_ENDPOINT="https://in.askdepth.com/v1/telemetry"
NEXT_PUBLIC_ASKDEPTH_ENVIRONMENT="production"

# Deploy Token (ad_dep_...) for uploading .askdepth/component-maps on build
ASKDEPTH_DEPLOY_TOKEN=""
ASKDEPTH_INGEST_URL="https://in.askdepth.com"
ASKDEPTH_REPOSITORY="askdepth/demo-shop"

# --- AskDepth Audience Connector (/askdepth/v1/*) ---
# 64-hex-char shared secret generated in AskDepth -> Audience -> Connect Wizard
ASKDEPTH_CONNECTOR_SECRET=""
# Optional dedicated read-only PostgreSQL URL for Audience Connector (falls back to DATABASE_URL)
ASKDEPTH_CONNECTOR_DB_URL=""
